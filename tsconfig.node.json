{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "electron-vite/node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "electron.vite.config.ts",
    "vite.web.config.mts",
    "vitest*.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "e2e/**/*"
  ]
}
