{
  "name": "ledger-lift",
  "version": "0.1.0",
  "description": "Turn a photo of a handwritten sales ledger into reviewed rows and a CSV, on your own computer.",
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && vitest run --config vitest.e2e.config.mts",
    "score": "electron-vite build && vitest run e2e/score.e2e.test.ts --config vitest.e2e.config.mts --disable-console-intercept",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "web": "vite --config vite.web.config.mts"
  },
  "dependencies": {
    "undici": "^8.12.1"
  },
  "devDependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.57.0",
    "playwright": "^1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "author": "Ledger Lift"
}
